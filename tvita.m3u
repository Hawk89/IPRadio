<button id="gotop" aria-label="Torna su"><i class="fa fa-chevron-up"></i></button>

<script>
/* Navbar + scroll top */
var navbar = document.getElementById('navbar');
var gotop  = document.getElementById('gotop');
window.addEventListener('scroll', function(){
  var y = window.scrollY;
  navbar.classList.toggle('solid', y > 50);
  gotop.classList.toggle('on', y > 380);
}, {passive:true});
gotop.addEventListener('click', function(){ window.scrollTo({top:0, behavior:'smooth'}); });

/* Hamburger */
var hbg = document.getElementById('hbg');
var mob = document.getElementById('mobnav');
hbg.addEventListener('click', function(){
  var o = mob.classList.toggle('open');
  hbg.classList.toggle('open', o);
  hbg.setAttribute('aria-expanded', String(o));
  document.body.style.overflow = o ? 'hidden' : '';
});
document.addEventListener('click', function(e){
  if (!hbg.contains(e.target) && !mob.contains(e.target)){
    mob.classList.remove('open');
    hbg.classList.remove('open');
    hbg.setAttribute('aria-expanded','false');
    document.body.style.overflow = '';
  }
});
</script>

</body>
</html>



<!-- ══════════════════════════════════════════════
     COOKIE BANNER — Davide Fulgione
════════════════════════════════════════════════ -->
<div id="cookie-banner" role="dialog" aria-modal="true" aria-labelledby="cb-title" aria-describedby="cb-desc">
  <div class="cb-inner">

    <div class="cb-top">
      <div class="cb-icon" aria-hidden="true"><i class="fa fa-shield-halved"></i></div>
      <div class="cb-text">
        <p class="cb-title" id="cb-title">Questo sito utilizza cookie</p>
        <p class="cb-desc" id="cb-desc">
          Usiamo cookie tecnici (necessari al funzionamento) e cookie analitici tramite
          <strong>Google Analytics</strong> per capire come viene utilizzato il sito.
          Nessun cookie di profilazione o marketing.
          <a href="cookie.php" class="cb-link">Informativa completa</a>
        </p>
      </div>
    </div>

    <div class="cb-actions">
      <button class="cb-btn cb-btn--reject" id="cb-reject">Solo necessari</button>
      <button class="cb-btn cb-btn--accept" id="cb-accept">Accetta tutti</button>
    </div>

  </div>
</div>

<style>
#cookie-banner {
  position: fixed;
  bottom: 1.5rem;
  left: 50%;
  transform: translateX(-50%) translateY(120%);
  z-index: 9999;
  width: min(92vw, 620px);
  background: rgba(13, 8, 28, 0.92);
  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
  border: 1px solid rgba(208,24,171,.28);
  border-radius: 18px;
  box-shadow: 0 8px 48px rgba(0,0,0,.65), 0 1px 0 rgba(208,24,171,.15) inset;
  padding: 1.4rem 1.6rem;
  transition: transform .45s cubic-bezier(.22,1,.36,1), opacity .35s ease;
  opacity: 0;
  font-family: 'Inter', sans-serif;
}
#cookie-banner.cb-show {
  transform: translateX(-50%) translateY(0);
  opacity: 1;
}
#cookie-banner.cb-hide {
  transform: translateX(-50%) translateY(130%);
  opacity: 0;
}
.cb-inner { display: flex; flex-direction: column; gap: 1.1rem; }
.cb-top   { display: flex; align-items: flex-start; gap: 1rem; }
.cb-icon  {
  flex-shrink: 0;
  width: 38px; height: 38px; border-radius: 10px;
  background: rgba(208,24,171,.12);
  border: 1px solid rgba(208,24,171,.25);
  display: flex; align-items: center; justify-content: center;
  color: #d018ab; font-size: .95rem;
}
.cb-title {
  font-size: .82rem; font-weight: 600;
  color: #f5f2ff; margin: 0 0 .3rem;
  letter-spacing: -.01em;
}
.cb-desc {
  font-size: .74rem; font-weight: 300;
  color: rgba(232,228,240,.65);
  line-height: 1.65; margin: 0;
}
.cb-desc strong { font-weight: 500; color: rgba(232,228,240,.85); }
.cb-link {
  color: #d018ab; text-decoration: underline;
  text-underline-offset: 2px; white-space: nowrap;
}
.cb-link:hover { color: #e066cc; }
.cb-actions {
  display: flex; gap: .65rem; justify-content: flex-end;
}
.cb-btn {
  padding: .52rem 1.25rem; border-radius: 40px;
  font-family: 'Inter', sans-serif;
  font-size: .76rem; font-weight: 500; letter-spacing: .02em;
  cursor: pointer; border: none; transition: .2s;
  white-space: nowrap;
}
.cb-btn--reject {
  background: rgba(255,255,255,.07);
  border: 1px solid rgba(255,255,255,.14);
  color: rgba(232,228,240,.7);
}
.cb-btn--reject:hover {
  background: rgba(255,255,255,.12);
  color: #f5f2ff;
}
.cb-btn--accept {
  background: linear-gradient(135deg, #d018ab, #8c0f70);
  color: #fff;
  box-shadow: 0 3px 14px rgba(208,24,171,.35);
}
.cb-btn--accept:hover { filter: brightness(1.1); transform: translateY(-1px); }

@media (max-width: 480px) {
  #cookie-banner { bottom: 1rem; padding: 1.1rem 1.1rem; border-radius: 14px; }
  .cb-actions { flex-direction: column; }
  .cb-btn { width: 100%; text-align: center; padding: .62rem 1rem; }
  .cb-btn--accept { order: -1; }
}
</style>

<script>
(function(){
  var banner  = document.getElementById('cookie-banner');
  var btnAcc  = document.getElementById('cb-accept');
  var btnRej  = document.getElementById('cb-reject');

  // Mostra con leggero delay
  setTimeout(function(){ banner.classList.add('cb-show'); }, 800);

  function setCookie(name, value, days){
    var d = new Date();
    d.setTime(d.getTime() + days * 86400000);
    document.cookie = name + '=' + value + ';expires=' + d.toUTCString() + ';path=/;SameSite=Lax';
  }

  function hideBanner(){
    banner.classList.remove('cb-show');
    banner.classList.add('cb-hide');
    setTimeout(function(){ banner.remove(); }, 500);
  }

  // Accetta tutti — attiva GA
  btnAcc.addEventListener('click', function(){
    setCookie('df_cookie_consent', 'all', 365);
    hideBanner();
    // Sblocca Google Analytics
    if (typeof gtag === 'function') {
      gtag('consent', 'update', { analytics_storage: 'granted' });
    }
  });

  // Solo necessari — GA rimane bloccato
  btnRej.addEventListener('click', function(){
    setCookie('df_cookie_consent', 'necessary', 365);
    hideBanner();
    if (typeof gtag === 'function') {
      gtag('consent', 'update', { analytics_storage: 'denied' });
    }
  });
})();
</script>
