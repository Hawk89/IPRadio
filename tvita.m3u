<script>
(function(){
  // Slider solo su desktop — su mobile rimane fisso su 12.jpg
  if (window.innerWidth >= 1025) {
    var sl  = document.querySelectorAll('.slides .slide');
    var cur = 0;
    setInterval(function(){
      sl[cur].classList.remove('active');
      cur = (cur + 1) % sl.length;
      sl[cur].classList.add('active');
    }, 5000);
  }

  // Ricerca blog
  var inp = document.getElementById('hero-search-input');
  var btn = document.getElementById('hero-search-btn');
  function doSearch(){
    var q = inp.value.trim();
    if (q !== '') {
      window.location.href = 'blog.php?q=' + encodeURIComponent(q);
    }
  }
  btn.addEventListener('click', doSearch);
  inp.addEventListener('keydown', function(e){
    if (e.key === 'Enter') doSearch();
  });
})();
</script>

<!-- Pulsante PayPal ufficiale: reso fuori schermo e pilotato dalla
     card di sostegno. Se lo script non arriva (blocco pubblicitario,
     rete), il pulsante resta un link vero al modulo ospitato. -->
<div class="dfs-pp-sdk" aria-hidden="true"><div id="dfs-pp-btn"></div></div>

<script>
(function () {
  var pot = document.getElementById('dfs-pp-btn');
  if (!pot) return;

  var s = document.createElement('script');
  s.src = 'https://www.paypalobjects.com/donate/sdk/donate-sdk.js';
  s.charset = 'UTF-8';
  s.async = true;
  s.onload = function () {
    if (!window.PayPal || !window.PayPal.Donation) return;
    try {
      PayPal.Donation.Button({
        env: 'production',
        hosted_button_id: '9XPQBN8MQVZE2',
        image: {
          src:   'https://www.paypalobjects.com/it_IT/IT/i/btn/btn_donate_SM.gif',
          alt:   'Fai una donazione con il pulsante PayPal',
          title: 'PayPal - The safer, easier way to pay online!'
        }
      }).render('#dfs-pp-btn');
    } catch (e) {}
  };
  document.head.appendChild(s);

  document.addEventListener('click', function (ev) {
    var a = ev.target.closest ? ev.target.closest('[data-pp]') : null;
    if (!a) return;
    var vero = pot.querySelector('a, img, button, input');
    if (!vero) return;   // SDK non disponibile: vale href del link
    ev.preventDefault();
    vero.click();
  });
})();
</script>

