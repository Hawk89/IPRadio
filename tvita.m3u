<script>
(function(){
  var banner = document.getElementById('community-banner');
  if (!banner) return;

  setTimeout(function(){ banner.classList.add('cmb-show'); }, 1300);

  function setCookie(name, value, days){
    var d = new Date();
    d.setTime(d.getTime() + days * 86400000);
    document.cookie = name + '=' + value + ';expires=' + d.toUTCString() + ';path=/;SameSite=Lax';
  }

  function hideBanner(){
    banner.classList.remove('cmb-show');
    banner.classList.add('cmb-hide');
    setTimeout(function(){ banner.remove(); }, 500);
  }

  document.getElementById('cmb-close').addEventListener('click', function(){
    setCookie('df_community_banner_dismissed', '1', 365);
    hideBanner();
  });

  // -- Mini form newsletter -------------------------------
  var form  = document.getElementById('cmb-nl-form');
  var input = document.getElementById('cmb-nl-email');
  var msg   = document.getElementById('cmb-nl-msg');
  var btn   = document.getElementById('cmb-nl-submit');
  var lastSub = 0;

  form.addEventListener('submit', function(e){
    e.preventDefault();
    var now = Date.now();
    if (now - lastSub < 8000) return;
    lastSub = now;
    var email = input.value.trim();
    var honey = document.getElementById('cmb-nl-honey').value;
    if (!email) { showMsg('Inserisci la tua email.', 'error'); return; }
    btn.disabled = true; btn.classList.add('loading');
    msg.className = 'cmb-nl-msg'; msg.textContent = '';
    var fd = new FormData();
    fd.append('email', email);
    fd.append('website', honey);
    fd.append('csrf_token', document.getElementById('cmb-nl-csrf').value);
    fetch('newsletter_subscribe.php', { method: 'POST', body: fd })
      .then(function(r){ return r.json(); })
      .then(function(data){
        showMsg(data.message, data.status);
        if (data.status === 'success' || data.status === 'already') input.value = '';
      })
      .catch(function(){ showMsg('Errore di rete. Riprova tra poco.', 'error'); })
      .finally(function(){ btn.disabled = false; btn.classList.remove('loading'); });
  });

  function showMsg(text, type){
    msg.textContent = text;
    msg.className = 'cmb-nl-msg cmb-nl-msg--' + type + ' cmb-nl-msg--visible';
  }
})();
