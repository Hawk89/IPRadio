    <section class="appsbox-section page-section" id="le-mie-app">
    <style>
    /* Promo app/prodotti (scoped .appsbox-*) — slim, senza card di sfondo */
    /* Sfondo: la stessa foto della Ludoteca, sfocata da un velo con
       backdrop-filter. Il velo sta sopra il background della sezione,
       quindi sfoca la foto e non il contenuto, che sale con z-index. */
    .appsbox-section {
      position: relative;
      padding: clamp(2.5rem,5vw,4rem) clamp(1.25rem,5vw,3rem) clamp(3rem,5vw,4.5rem);
      background: url('img/sfondo.jpg') center center / cover no-repeat;
    }
    .appsbox-section::before {
      content: ''; position: absolute; inset: 0; z-index: 0;
      background: rgba(7,5,14,.76);
      -webkit-backdrop-filter: blur(28px) saturate(115%);
      backdrop-filter: blur(28px) saturate(115%);
    }
    @supports not ((backdrop-filter: blur(2px)) or (-webkit-backdrop-filter: blur(2px))) {
      .appsbox-section::before { background: rgba(7,5,14,.94); }
    }
    .appsbox-card { position: relative; z-index: 1; max-width: 1100px; margin: 0 auto; }
    .appsbox-head { text-align: center; max-width: 600px; margin: 0 auto clamp(1.2rem,3vw,1.8rem); }
    .appsbox-badge {
      display: inline-flex; align-items: center; gap: .45rem;
      padding: .26rem .8rem; border-radius: 30px;
      background: rgba(208,24,171,.1); border: 1px solid rgba(208,24,171,.28);
      font-size: .66rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: #e066cc; margin-bottom: .85rem;
    }
    .appsbox-title { font-size: clamp(1.35rem,3vw,1.8rem); font-weight: 700; letter-spacing: -.025em; color: #f7f4ff; margin: 0 0 .45rem; line-height: 1.15; }
    .appsbox-sub { font-size: .85rem; color: rgba(255,255,255,.55); margin: 0; line-height: 1.65; }
    /* Scroller orizzontale: stessa meccanica di .blog-track,
       mossa dalla initScroller() globale della sezione blog. */
    .appsbox-scroll-area { position: relative; }
    .appsbox-track-wrap {
      overflow-x: auto; overflow-y: visible;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      scrollbar-width: none; -ms-overflow-style: none;
      padding: .5rem 0 1rem;
    }
    .appsbox-track-wrap::-webkit-scrollbar { display: none; }
    .appsbox-track { display: flex; gap: 1rem; width: max-content; }
    .appsbox-arrow {
